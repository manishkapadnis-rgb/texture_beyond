Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS in production (uncomment after SSL is active)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # SEO friendly URLs
  RewriteRule ^product/([a-z0-9-]+)/?$         product.php?slug=$1 [L,QSA]
  RewriteRule ^category/([a-z0-9-]+)/?$        shop.php?category=$1 [L,QSA]
  RewriteRule ^collection/([a-z0-9-]+)/?$      shop.php?category=$1 [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$            blog-detail.php?slug=$1 [L,QSA]
  RewriteRule ^page/([a-z0-9-]+)/?$            page.php?slug=$1 [L,QSA]
  RewriteRule ^shop/?$                          shop.php [L]
  RewriteRule ^collections/?$                   collections.php [L]
  RewriteRule ^gallery/?$                       gallery.php [L]
  RewriteRule ^about/?$                         about.php [L]
  RewriteRule ^contact/?$                       contact.php [L]
  RewriteRule ^blog/?$                          blog.php [L]
  RewriteRule ^cart/?$                          cart.php [L]
  RewriteRule ^checkout/?$                      checkout.php [L]
  RewriteRule ^login/?$                         login.php [L]
  RewriteRule ^my-account/?$                    my-account.php [L]
  RewriteRule ^wishlist/?$                      wishlist.php [L]
</IfModule>

# Protect sensitive folders
RedirectMatch 403 ^/config/
RedirectMatch 403 ^/includes/.*\.php$
RedirectMatch 403 ^/database/
RedirectMatch 403 ^/logs/

# Asset caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
